/**
 * Product Research Agent (Module B).
 *
 * Product opportunity scoring is transparent, evidence-based and never
 * fabricated. Scores distinguish search interest, advertising activity, social
 * engagement and actual verified sales data. Data sources and dates are shown.
 */

export interface ResearchInputs {
  keyword: string;
  category?: string;
  country?: string;
  targetAudience?: string;
  priceRangeMin?: number;
  priceRangeMax?: number;
  supplier?: string;
  shippingPreferences?: string;
}

export interface Evidence {
  searchInterestScore: number;      // 0-100 (Google Trends-like)
  advertisingActivityScore: number; // 0-100 (Meta/TikTok ads)
  socialEngagementScore: number;    // 0-100
  verifiedSalesData?: number;       // 0-100, only if real sales source available
  dataSource: string[];
  researchedAt: Date;
  confidence: "low" | "medium" | "high";
}

export interface ProductOpportunityResult {
  externalProductId?: string;
  title: string;
  image?: string;
  category?: string;
  supplierCount: number;
  lowestSupplierPrice?: number;
  estimatedLandedCost?: number;
  suggestedSellingPrice?: number;
  estimatedProfit?: number;
  demandScore: number;         // 0-100
  competitionScore: number;    // 0-100
  opportunityScore: number;    // 0-100
  evidence: Evidence;
}

export interface ScoringBreakdown {
  demand: number;
  competition: number;
  profit: number;
  supplier: number;
  shipping: number;
  total: number;
}

/**
 * Compute a transparent opportunity score out of 100.
 *
 * Weights:
 *   Demand (market + growth)        30%
 *   Competition (saturation)        25%  (lower competition = higher score)
 *   Profit potential                20%
 *   Supplier availability           15%
 *   Shipping viability              10%
 *
 * Demand is derived from search interest + advertising activity + social
 * engagement — NOT from views/likes alone. Verified sales data, when present,
 * raises confidence.
 */
export function scoreOpportunity(
  inputs: {
    searchInterestScore: number;      // 0-100
    advertisingActivityScore: number; // 0-100
    socialEngagementScore: number;    // 0-100
    verifiedSalesData?: number;       // 0-100
    competitionScore: number;         // 0-100 (100 = very competitive)
    estimatedProfit: number;          // currency
    estimatedMargin: number;          // fraction
    supplierCount: number;
    stockAvailable: boolean;
    shippingAvailable: boolean;
  },
): { opportunityScore: number; breakdown: ScoringBreakdown; confidence: "low" | "medium" | "high" } {
  const {
    searchInterestScore,
    advertisingActivityScore,
    socialEngagementScore,
    verifiedSalesData,
    competitionScore,
    estimatedProfit,
    estimatedMargin,
    supplierCount,
    stockAvailable,
    shippingAvailable,
  } = inputs;

  // Demand: blend of search interest, ads, social. Verified sales boosts it.
  const demandRaw =
    searchInterestScore * 0.4 +
    advertisingActivityScore * 0.35 +
    socialEngagementScore * 0.25;
  let demandScore = Math.round(clamp(demandRaw));
  if (verifiedSalesData != null) {
    demandScore = Math.round(demandScore * 0.7 + verifiedSalesData * 0.3);
  }

  // Competition: invert so less competition = higher score
  const competitionScoreInverted = Math.round(clamp(100 - competitionScore));

  // Profit: blend of margin and absolute profit (capped)
  const profitComponent = Math.round(clamp(estimatedMargin * 100, 0, 100) * 0.6 + clamp(Math.min(estimatedProfit, 10000) / 100, 0, 100) * 0.4);

  // Supplier: availability + count
  const supplierScore = Math.round(
    (stockAvailable ? 80 : 20) * 0.7 + Math.min(supplierCount, 10) * 10 * 0.3,
  );

  // Shipping
  const shippingScore = shippingAvailable ? 100 : 20;

  const breakdown: ScoringBreakdown = {
    demand: demandScore,
    competition: competitionScoreInverted,
    profit: profitComponent,
    supplier: supplierScore,
    shipping: shippingScore,
  };

  const total =
    demandScore * 0.3 +
    competitionScoreInverted * 0.25 +
    profitComponent * 0.2 +
    supplierScore * 0.15 +
    shippingScore * 0.1;

  // Confidence: high only if verified sales data exists
  let confidence: "low" | "medium" | "high" = "low";
  if (verifiedSalesData != null) confidence = "high";
  else if (searchInterestScore > 0 || advertisingActivityScore > 0) confidence = "medium";

  return {
    opportunityScore: Math.round(clamp(total)),
    breakdown,
    confidence,
  };
}

function clamp(value: number, min = 0, max = 100): number {
  return Math.min(max, Math.max(min, value));
}

/**
 * Build an evidence record from permitted/authorized data sources. Never
 * fabricates sales figures.
 */
export function buildEvidence(
  inputs: {
    searchInterestScore: number;
    advertisingActivityScore: number;
    socialEngagementScore: number;
    verifiedSalesData?: number;
    dataSources: string[];
  },
): Evidence {
  return {
    searchInterestScore: Math.round(clamp(inputs.searchInterestScore)),
    advertisingActivityScore: Math.round(clamp(inputs.advertisingActivityScore)),
    socialEngagementScore: Math.round(clamp(inputs.socialEngagementScore)),
    verifiedSalesData: inputs.verifiedSalesData != null ? Math.round(clamp(inputs.verifiedSalesData)) : undefined,
    dataSource: inputs.dataSources,
    researchedAt: new Date(),
    confidence: inputs.verifiedSalesData != null ? "high" : "medium",
  };
}
