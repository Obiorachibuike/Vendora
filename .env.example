# ─────────────────────────────────────────────────────────────
# Vendora AI — environment template
# Copy to .env.local and fill in. .env* is gitignored (except this file).
# ─────────────────────────────────────────────────────────────

# ─── Database (required) ──────────────────────────────────────
# Postgres connection string. Use a pooled URL on serverless
# (Neon/Supabase/RDS + PgBouncer, e.g. "?pgbouncer=true&connection_limit=1").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vendora

# ─── Auth (required) ──────────────────────────────────────────
# Session signing secret (HS256). REQUIRED even for `next build` —
# the auth module throws at import time without it.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Optional auth tuning
# SESSION_COOKIE_NAME=vendora_session
# CSRF_COOKIE_NAME=vendora_csrf
# BCRYPT_SALT_ROUNDS=12

# ─── Credential encryption (required for supplier connections) ─
# AES-256-GCM key for supplier credentials / platform tokens.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── AI provider (optional — AI assistant / research) ─────────
# AI_PROVIDER=agnes
# AGNES_API_KEY=
# AGNES_MODEL=
# AGNES_API_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_MODEL=

# ─── Payments (optional in development) ───────────────────────
# Webhook signing secrets + provider keys used by the API routes.
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── Worker / job queue (optional) ────────────────────────────
# Long-running worker (`npm run worker`) needs its own connection.
# Defaults to DATABASE_URL when unset.
# PGBOSS_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/vendora
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT=30000
# DB_CONNECT_TIMEOUT=10000
